# StudyMate AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to Git.

# Secret key for Flask session signing.
# In production, set a long random string:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# SQLite database file path (relative to backend/ or absolute path)
DATABASE_PATH=studymate.db

# Ollama base URL — Ollama must be running
OLLAMA_BASE_URL=http://localhost:11434

# Gemma model name as it appears in `ollama list`
# Example: gemma4:latest, gemma3:1b, etc.
OLLAMA_MODEL=gemma4:latest

# Allowed Frontend Origins (CORS) — comma-separated for multiple origins
# Example: http://localhost:3000,https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Cookie security settings (set SECURE=true and SAMESITE=None if deploying cross-domain over HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Server port (used when running via python app.py)
PORT=5000
FLASK_DEBUG=1
