# StudyMate AI — Backend Environment Variables (Example Template)
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# NEVER commit the actual .env file with real secrets to Git.

# --- Security & Session Signing ---
# Secret key for Flask session signing. Use a strong, random 32+ character string.
SECRET_KEY=your-secret-key-here-minimum-32-chars

# Cookie security settings (false for local HTTP development; true for HTTPS in production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# --- Server Configuration ---
# Port on which the local Flask backend will listen
PORT=5000

# Flask debug mode (1 for local development, 0 for production)
FLASK_DEBUG=1

# --- Database ---
# SQLite database file path (relative to backend/ directory or absolute path)
DATABASE_PATH=studymate.db

# --- Offline AI / LLM Configuration (Ollama & Gemma) ---
# Ollama service endpoint (must be running locally for offline mode)
OLLAMA_BASE_URL=http://localhost:11434

# Installed model tag in Ollama (e.g. gemma4:latest)
OLLAMA_MODEL=gemma4:latest

# --- CORS Settings ---
# Allowed frontend origin URLs (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:3000
